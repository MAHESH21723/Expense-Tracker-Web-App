# Copy to .env and edit. The app reads real environment variables
# (python-dotenv is not required); set them in your shell if you like.

# Session/CSRF signing key. If unset, a random key is generated on every start.
SECRET_KEY=

# Set to 1 to enable Flask debug mode (local development only).
FLASK_DEBUG=0

# Optional path of the SQLite database file (default: instance/expense_tracker.db).
EXPENSE_DB=
